{% extends 'layout/base.html.twig' %}

{% block title %}Employees{% endblock %}
{% block page_title %}Employees{% endblock %}

{% set active_page = 'Employees' %}

{% block stylesheets %}
    <style>

        .add-card {
            animation: slideDown .4s ease both;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .section-title::before {
            content: '';
            display: inline-block;
            width: 4px; height: 1.3em;
            background: var(--teal);
            border-radius: 4px;
            flex-shrink: 0;
        }

        .badge-active {
            background: #d1f5e4;
            color: #1a7a4a;
            font-weight: 600;
            font-size: .74rem;
            letter-spacing: .05em;
            border-radius: 20px;
            padding: .3em .75em;
        }

        .search-wrap { position: relative; }
        .search-wrap .bi-search {
            position: absolute;
            top: 50%; left: .85rem;
            transform: translateY(-50%);
            color: #9ba4ac;
            pointer-events: none;
        }
        .search-wrap input { padding-left: 2.2rem; }

        .btn-action {
            padding: .3rem .65rem;
            font-size: .78rem;
            font-weight: 600;
            border-radius: 6px;
        }

        .empty-state {
            padding: 3rem 1rem;
            color: #9ba4ac;
            font-size: .95rem;
        }

        .empty-state i { font-size: 2.5rem; display: block; margin-bottom: .75rem; }

        #toast-container {
            position: fixed;
            bottom: 24px; right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast-msg {
            padding: .75rem 1.25rem;
            border-radius: 10px;
            font-weight: 500;
            font-size: .875rem;
            box-shadow: 0 4px 16px rgba(0,0,0,.18);
            animation: toastIn .3s ease;
            min-width: 240px;
        }

        .toast-success { background: #d1f5e4; color: #1a7a4a; border-left: 4px solid #2bb569; }
        .toast-error   { background: #fde8e8; color: #b91c1c; border-left: 4px solid #ef4444; }

        @keyframes toastIn {
            from { opacity: 0; transform: translateX(40px); }
            to   { opacity: 1; transform: translateX(0); }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="container page-content">

        <section class="card stats-card p-4 mb-5 add-card">
            <h3 class="section-title mb-4">Add New Employee</h3>

            {{ form_start(form, {
                'attr': {'id': 'employeeForm', 'novalidate': 'novalidate'},
                'action': path('employee_index'),
                'method': 'POST'
            }) }}

            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_label(form.firstName) }}
                    {{ form_widget(form.firstName) }}
                    {{ form_errors(form.firstName) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.department) }}
                    {{ form_widget(form.department) }}
                    {{ form_errors(form.department) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.position) }}
                    {{ form_widget(form.position) }}
                    {{ form_errors(form.position) }}
                </div>
                <div class="col-md-6">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold">CV</label>
                    <div class="input-group">
                        <input type="text" id="cvPathInput" name="cv_path"
                               class="form-control" placeholder="No CV uploaded yet" readonly>
                        <button type="button" class="btn btn-teal">
                            <i class="bi bi-upload me-1"></i> Upload CV
                        </button>
                    </div>
                    <div class="form-text text-muted">Click "Upload CV" to attach a CV file.</div>
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-teal px-5 py-2 fw-semibold">
                        <i class="bi bi-person-plus me-2"></i>Add Employee
                    </button>
                </div>
            </div>

            {{ form_end(form) }}
        </section>

        <section class="row mb-4 g-2 align-items-end">
            <div class="col-md-6">
                <div class="search-wrap">
                    <i class="bi bi-search"></i>
                    <input id="searchInput" type="text" class="form-control"
                           placeholder="Search by name or ID…"
                           value="{{ search }}">
                </div>
            </div>
            <div class="col-md-2">
                <button id="applyBtn" class="btn btn-teal w-100 fw-semibold">Apply</button>
            </div>
        </section>

        <section class="card stats-card p-4 mb-5">
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <h3 class="section-title mb-0">Employee List</h3>
                <span class="badge" style="background:rgba(56,128,135,.12);color:var(--teal);font-size:.8rem;padding:.45em .9em;border-radius:20px;">
                {{ employees|length }} employee{{ employees|length != 1 ? 's' : '' }}
            </span>
            </div>

            <div class="table-wrap">
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID</th>
                        <th>Position</th>
                        <th>Department</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody id="employeeTableBody">
                    {% if employees is empty %}
                        <tr>
                            <td colspan="7">
                                <div class="empty-state text-center">
                                    <i class="bi bi-people"></i>
                                    No employees found
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {% for emp in employees %}
                            <tr data-id="{{ emp.id }}">
                                <td class="fw-semibold">{{ emp.firstName }}</td>
                                <td class="text-muted">#{{ emp.id }}</td>
                                <td>{{ emp.position ?: '—' }}</td>
                                <td>
                                <span class="badge"
                                      style="background:rgba(16,46,74,.08);color:var(--navy);border-radius:20px;padding:.3em .75em;">
                                    {{ emp.department }}
                                </span>
                                </td>
                                <td class="text-muted">{{ emp.email }}</td>
                                <td><span class="badge-active">Active</span></td>
                                <td>
                                    <a href="{{ path('employee_view', {id: emp.id}) }}"
                                       class="btn btn-sm btn-outline-primary btn-action me-1">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a href="{{ path('employee_edit', {id: emp.id}) }}"
                                       class="btn btn-sm btn-outline-warning btn-action me-1">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger btn-action btn-delete"
                                            data-id="{{ emp.id }}"
                                            data-token="{{ csrf_token('delete_employee_' ~ emp.id) }}">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <div id="toast-container"></div>
{% endblock %}

{% block javascripts %}
    <script>
        function toast(msg, type = 'success') {
            const c = document.getElementById('toast-container');
            const el = document.createElement('div');
            el.className = `toast-msg toast-${type}`;
            el.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>${msg}`;
            c.appendChild(el);
            setTimeout(() => el.remove(), 3500);
        }


        document.getElementById('employeeForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const fd = new FormData(this);

            try {
                const res  = await fetch('{{ path("employee_index") }}', {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();

                if (json.status === 'success') {
                    toast(json.message);
                    setTimeout(() => location.reload(), 800);
                } else {
                    toast(json.message || 'An error occurred.', 'error');
                }
            } catch {
                toast('Network error while adding employee.', 'error');
            }
        });


        document.getElementById('employeeTableBody').addEventListener('click', async function(e) {
            const btn = e.target.closest('.btn-delete');
            if (!btn) return;

            if (!confirm('Are you sure you want to delete this employee?')) return;

            const id    = btn.dataset.id;
            const token = btn.dataset.token;
            const row   = btn.closest('tr');

            try {
                const fd = new FormData();
                fd.append('_token', token);

                const res  = await fetch(`/employees/${id}/delete`, { method: 'POST', body: fd });
                const json = await res.json();

                if (json.status === 'success') {
                    row.style.opacity = '0';
                    row.style.transition = 'opacity .3s';
                    setTimeout(() => row.remove(), 300);
                    toast('Employee deleted successfully.');
                } else {
                    toast(json.message || 'Delete failed.', 'error');
                }
            } catch (err) {
                toast('Network error while deleting.', 'error');
            }
        });


        document.getElementById('searchInput').addEventListener('keyup', function() {
            const q    = this.value.toLowerCase();
            const rows = document.querySelectorAll('#employeeTableBody tr[data-id]');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });

    </script>
{% endblock %}
