{% extends 'layout/base.html.twig' %}

{% block title %}Employee Details{% endblock %}
{% block page_title %}Employees{% endblock %}
{% set active_page = 'Employees' %}

{% block stylesheets %}
    <style>
        .detail-card {
            max-width: 680px;
            margin: 0 auto;
            animation: fadeUp .4s ease both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .detail-header {
            background: linear-gradient(135deg, var(--teal), var(--navy));
            border-radius: var(--radius) var(--radius) 0 0;
            padding: 2.5rem 2rem;
            color: white;
            text-align: center;
        }

        .avatar-circle {
            width: 80px; height: 80px;
            background: rgba(255,255,255,.2);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem;
            font-size: 2rem;
            font-weight: 700;
            font-family: 'Syne', sans-serif;
            border: 3px solid rgba(255,255,255,.4);
        }

        .detail-body { padding: 2rem; }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: .9rem 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .detail-item:last-child { border-bottom: none; }

        .detail-icon {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: rgba(56,128,135,.1);
            display: flex; align-items: center; justify-content: center;
            color: var(--teal);
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .detail-label {
            font-size: .75rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #9ba4ac;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .detail-value { font-weight: 500; color: #1a1a1a; }
    </style>
{% endblock %}

{% block body %}
    <main class="container page-content">
        <div class="detail-card card shadow-sm">

            <div class="detail-header">
                <div class="avatar-circle">{{ employee.firstName|first|upper }}</div>
                <h2 class="mb-1 fw-bold" style="font-family:'Syne',sans-serif;">{{ employee.firstName }}</h2>
                <p class="mb-0 opacity-75">{{ employee.position ?: 'No position set' }}</p>
            </div>

            <div class="detail-body">
                <div class="detail-item">
                    <div class="detail-icon"><i class="bi bi-hash"></i></div>
                    <div>
                        <div class="detail-label">Employee ID</div>
                        <div class="detail-value">#{{ employee.id }}</div>
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-icon"><i class="bi bi-envelope"></i></div>
                    <div>
                        <div class="detail-label">Email</div>
                        <div class="detail-value">{{ employee.email }}</div>
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-icon"><i class="bi bi-diagram-3"></i></div>
                    <div>
                        <div class="detail-label">Department</div>
                        <div class="detail-value">{{ employee.department }}</div>
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-icon"><i class="bi bi-briefcase"></i></div>
                    <div>
                        <div class="detail-label">Position</div>
                        <div class="detail-value">{{ employee.position ?: '—' }}</div>
                    </div>
                </div>
                {% if employee.hireDate %}
                    <div class="detail-item">
                        <div class="detail-icon"><i class="bi bi-calendar3"></i></div>
                        <div>
                            <div class="detail-label">Hire Date</div>
                            <div class="detail-value">{{ employee.hireDate|date('d M Y') }}</div>
                        </div>
                    </div>
                {% endif %}
                <div class="detail-item">
                    <div class="detail-icon"><i class="bi bi-circle-fill" style="color:#2bb569;font-size:.5rem;"></i></div>
                    <div>
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                        <span style="background:#d1f5e4;color:#1a7a4a;padding:.25em .75em;border-radius:20px;font-size:.8rem;font-weight:600;">
                            Active
                        </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a href="{{ path('employee_edit', {id: employee.id}) }}"
                       class="btn btn-teal fw-semibold flex-fill">
                        <i class="bi bi-pencil me-2"></i>Edit
                    </a>
                    <a href="{{ path('employee_index') }}"
                       class="btn btn-outline-secondary fw-semibold flex-fill">
                        <i class="bi bi-arrow-left me-2"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
