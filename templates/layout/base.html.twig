<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entreprisa — {% block title %}Dashboard{% endblock %}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>

        :root {
            --teal:        #388087;
            --teal-dark:   #2a6168;
            --forest:      #0d1f1b;
            --bg:          #F6F6F2;
            --navy:        #102E4A;
            --radius:      12px;
            --shadow:      0 4px 24px rgba(13,31,27,.10);
        }


        *, *::before, *::after { box-sizing: border-box; }

        body {
            background: var(--bg);
            font-family: 'Inter', sans-serif;
            font-size: .9375rem;
            color: #1a1a1a;
        }


        .custom-navbar {
            background: linear-gradient(90deg, var(--teal), var(--forest));
            box-shadow: 0 2px 12px rgba(0,0,0,.25);
        }

        .custom-navbar .navbar-brand {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            letter-spacing: .03em;
        }

        .custom-navbar .nav-link {
            font-weight: 500;
            font-size: .875rem;
            letter-spacing: .02em;
            color: rgba(255,255,255,.78) !important;
            position: relative;
            padding-bottom: 4px;
            transition: color .2s;
        }

        .custom-navbar .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0; left: 50%; right: 50%;
            height: 2px;
            background: white;
            border-radius: 2px;
            transition: left .25s, right .25s;
        }

        .custom-navbar .nav-link:hover,
        .custom-navbar .nav-link.active {
            color: #fff !important;
        }

        .custom-navbar .nav-link:hover::after,
        .custom-navbar .nav-link.active::after {
            left: 0; right: 0;
        }

        .dropdown-toggle::after { display: none !important; }

        .dropdown-menu {
            background: #1e2d2a;
            border: none;
            border-radius: 10px;
            padding: 8px 0;
            box-shadow: 0 8px 24px rgba(0,0,0,.3);
        }

        .dropdown-item {
            color: rgba(255,255,255,.85);
            font-weight: 500;
            padding: .55rem 1.25rem;
            transition: background .2s;
        }

        .dropdown-item:hover { background: rgba(255,255,255,.1); color: #fff; }

        .page-content { padding-top: 110px; padding-bottom: 40px; }

        .card {
            border: none;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .stats-card {
            background: #fff;
            border-left: 4px solid var(--teal) !important;
            transition: transform .25s;
        }

        .stats-card:hover { transform: translateY(-4px); }

        .table-wrap { overflow-x: auto; }

        .table {
            width: 100%;
            text-align: center;
            border-collapse: separate;
            border-spacing: 0;
        }

        .table thead tr {
            background: var(--navy);
            color: #fff;
        }

        .table thead th {
            padding: .85rem 1rem;
            font-weight: 600;
            font-size: .8125rem;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .table tbody tr {
            border-bottom: 1px solid #e9ecef;
            transition: background .15s;
        }

        .table tbody tr:hover { background: #f0f7f8; }

        .table td {
            padding: .75rem 1rem;
            vertical-align: middle;
            font-size: .875rem;
        }

        .btn-teal {
            background: var(--teal);
            color: #fff;
            border: none;
            font-weight: 600;
            letter-spacing: .02em;
            transition: background .2s, transform .15s;
        }

        .btn-teal:hover { background: var(--teal-dark); color: #fff; transform: translateY(-1px); }

        .btn-outline-primary:hover,
        .btn-outline-warning:hover,
        .btn-outline-danger:hover { color: #fff; }

        .form-control, .form-select {
            border: 1.5px solid #dee2e6;
            border-radius: 8px;
            transition: border-color .2s, box-shadow .2s, transform .2s;
            font-size: .9rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(56,128,135,.15);
            transform: translateX(3px);
            outline: none;
        }

        .footer-forest {
            background: linear-gradient(180deg, var(--teal) 0%, var(--forest) 100%);
            border-top: 1px solid rgba(255,255,255,.1);
        }

        .footer-link {
            color: rgba(255,255,255,.8);
            text-decoration: none;
            font-size: .9rem;
            transition: color .2s, padding-left .2s;
        }

        .footer-link:hover { color: #fff; padding-left: 5px; }

        #offcanvasSidebar { background: var(--forest); color: #fff; }

        #offcanvasSidebar .nav-link {
            color: rgba(255,255,255,.78);
            border-radius: 8px;
            padding: .55rem 1rem;
            font-weight: 500;
            transition: background .2s, color .2s;
        }

        #offcanvasSidebar .nav-link:hover,
        #offcanvasSidebar .nav-link.active {
            background: rgba(56,128,135,.22);
            color: #fff;
        }

        .flash-container {
            position: fixed;
            top: 80px; right: 20px;
            z-index: 9999;
            max-width: 360px;
        }
        @media (max-width: 991px) {
            .navbar-nav .dropdown-menu {
                position: absolute !important;
                float: none;
                right: 0;
                left: auto;
                margin-top: 10px;
                background-color: #212529;
                min-width: 160px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg fixed-top navbar-dark custom-navbar">
    <div class="container-fluid px-3">

        <button class="navbar-toggler me-2" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <img src="{{ asset('image/logoentreprisa.png') }}" height="46" width="64" alt="Logo">
        <a class="navbar-brand ms-2" href="#">
            {% block page_title %}{% endblock %} Dashboard
        </a>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto gap-2">
                {% set nav = [
                    ['Home',          'employee_index'],
                    ['Employees',     'employee_index'],
                    ['Clients',       'employee_index'],
                    ['Recruitment',   'employee_index'],
                    ['Stock',         'employee_index'],
                    ['Sales',         'employee_index'],
                    ['Management',    'employee_index'],
                    ['Articles',      'article_index'],
                    ['Finance',       'finance'],
                ] %}
                {% for item in nav %}
                    <li class="nav-item">
                        <a class="nav-link {% if item[0] == active_page|default('') %}active{% endif %}"
                           href="{{ path(item[1]) }}">{{ item[0] }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="navbar-nav ms-auto">
            <div class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                   data-bs-toggle="dropdown">
                    <img src="{{ asset('images/profile.png') }}"
                         width="32" height="32" class="rounded-circle me-2" alt="Profile">
                    <span class="d-none d-sm-inline">admin</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="background-color: #212529;">

                    <li><a class="dropdown-item text-white" href="{{ path('profile_index') }}"><img src="{{ asset('image/profile.png') }}" width="32" height="32" class="rounded-circle me-2">Profil</a></li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                    <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><img src="{{ asset('image/logout.png') }}" width="24" class="me-2">Logout</a></li>

                </ul>
            </div>
        </div>
    </div>
</nav>

<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasSidebar">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title fw-bold" style="font-family:'Syne',sans-serif;">ENTREPRISA</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="nav flex-column gap-2">
            {% set sidebar = [
                ['bi-house',        'Home',       'employee_index'],
                ['bi-people',       'Employees',  'employee_index'],
                ['bi-people-fill',  'Clients',    'employee_index'],
                ['bi-person-plus',  'Recruitment','employee_index'],
                ['bi-box-seam',     'Stock',      'employee_index'],
                ['bi-cart',         'Sales',      'employee_index'],
                ['bi-calendar-check','Management','employee_index'],
                ['bi-newspaper',    'Articles',   'article_index'],
                ['bi-cash-stack',   'Finance',    'finance'],
            ] %}
            {% for item in sidebar %}
                <li class="nav-item">
                    <a class="nav-link {% if item[1] == active_page|default('') %}active{% endif %}"
                       href="{{ path(item[2]) }}">
                        <i class="bi {{ item[0] }} me-3"></i>{{ item[1] }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>

<div class="flash-container">
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show shadow" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{% block body %}{% endblock %}

<footer class="footer-forest text-white py-5 mt-5">
    <div class="container">
        <div class="row gy-4 text-center text-md-start">
            <div class="col-lg-4">
                <div class="d-flex align-items-center gap-2 justify-content-center justify-content-md-start mb-3">
                    <img src="{{ asset('image/logoentreprisa.png') }}" height="52" width="70" alt="Logo">
                    <span class="fw-bold fs-4 text-uppercase" style="font-family:'Syne',sans-serif;">Entreprisa</span>
                </div>
                <p class="opacity-60 small">Modern enterprise management platform<br>powered by AI & innovation.</p>
            </div>
            <div class="col-6 col-md-4">
                <h6 class="text-uppercase small fw-bold mb-3 opacity-50">Division</h6>
                <ul class="list-unstyled">
                    <li class="mb-2"><a href="#" class="footer-link">Services &amp; AI</a></li>
                    <li class="mb-2"><a href="#" class="footer-link">Communications</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-4">
                <h6 class="text-uppercase small fw-bold mb-3 opacity-50">Support</h6>
                <ul class="list-unstyled">
                    <li class="mb-2"><a href="#" class="footer-link">Technical Help</a></li>
                    <li class="mb-2"><a href="#" class="footer-link">IT Support</a></li>
                </ul>
            </div>
        </div>
        <hr class="opacity-25 mt-4">
        <div class="text-center small opacity-50">
            &copy; 2026 Entreprisa Inc. — Services &amp; AI Division
        </div>
    </div>
</footer>

{% block javascripts %}{% endblock %}
</body>
</html>
