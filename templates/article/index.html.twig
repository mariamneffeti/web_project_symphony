{% extends 'layout/base.html.twig' %}

{% block title %}Articles{% endblock %}
{% block page_title %}Articles{% endblock %}
{% set active_page = 'Articles' %}

{% block stylesheets %}
    <style>
        /* ── Animations ──────────────────────────────────────────── */
        .add-card { animation: slideDown .4s ease both; }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Section title ───────────────────────────────────────── */
        .section-title {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--navy);
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .section-title::before {
            content: '';
            display: inline-block;
            width: 4px; height: 1.3em;
            background: var(--teal);
            border-radius: 4px;
            flex-shrink: 0;
        }

        /* ── Category badges ─────────────────────────────────────── */
        .cat-badge {
            display: inline-block;
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .05em;
            border-radius: 20px;
            padding: .28em .8em;
        }

        .cat-Technology   { background: #dbeafe; color: #1d4ed8; }
        .cat-DataAI       { background: #ede9fe; color: #6d28d9; }
        .cat-Cybersecurity{ background: #fee2e2; color: #b91c1c; }
        .cat-HRCareers    { background: #d1fae5; color: #065f46; }
        .cat-CompanyNews  { background: #fef3c7; color: #92400e; }
        .cat-default      { background: rgba(56,128,135,.12); color: var(--teal); }

        /* ── Image thumbnail ─────────────────────────────────────── */
        .img-thumb {
            width: 48px; height: 36px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid #e5e7eb;
        }

        .no-img {
            width: 48px; height: 36px;
            background: #f3f4f6;
            border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            color: #d1d5db;
            font-size: .9rem;
        }

        /* ── Search bar ──────────────────────────────────────────── */
        .search-wrap { position: relative; }
        .search-wrap .bi-search {
            position: absolute;
            top: 50%; left: .85rem;
            transform: translateY(-50%);
            color: #9ba4ac;
            pointer-events: none;
        }
        .search-wrap input { padding-left: 2.2rem; }

        /* ── Link cell ───────────────────────────────────────────── */
        .link-cell {
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: .8rem;
            color: var(--teal);
        }

        /* ── Action buttons ──────────────────────────────────────── */
        .btn-action {
            padding: .3rem .65rem;
            font-size: .78rem;
            font-weight: 600;
            border-radius: 6px;
        }

        /* ── Empty state ─────────────────────────────────────────── */
        .empty-state {
            padding: 3rem 1rem;
            color: #9ba4ac;
            font-size: .95rem;
        }
        .empty-state i { font-size: 2.5rem; display: block; margin-bottom: .75rem; }

        /* ── Toast ───────────────────────────────────────────────── */
        #toast-container {
            position: fixed;
            bottom: 24px; right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast-msg {
            padding: .75rem 1.25rem;
            border-radius: 10px;
            font-weight: 500;
            font-size: .875rem;
            box-shadow: 0 4px 16px rgba(0,0,0,.18);
            animation: toastIn .3s ease;
            min-width: 240px;
        }

        .toast-success { background: #d1f5e4; color: #1a7a4a; border-left: 4px solid #2bb569; }
        .toast-error   { background: #fde8e8; color: #b91c1c; border-left: 4px solid #ef4444; }

        @keyframes toastIn {
            from { opacity: 0; transform: translateX(40px); }
            to   { opacity: 1; transform: translateX(0); }
        }
    </style>
{% endblock %}

{% block body %}
    <main class="container page-content">

        {# ── Add Article form ───────────────────────────────────────── #}
        <section class="card stats-card p-4 mb-5 add-card">
            <h3 class="section-title mb-4">Add New Article</h3>

            <form id="articleForm" novalidate>
                <div class="row g-3">

                    <div class="col-md-6">
                        {{ form_label(form.title) }}
                        {{ form_widget(form.title) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.category) }}
                        {{ form_widget(form.category) }}
                        {{ form_errors(form.category) }}
                    </div>

                    <div class="col-md-12">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description) }}
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.authorName) }}
                        {{ form_widget(form.authorName) }}
                        {{ form_errors(form.authorName) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.arDate) }}
                        {{ form_widget(form.arDate) }}
                        {{ form_errors(form.arDate) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.link) }}
                        {{ form_widget(form.link) }}
                        {{ form_errors(form.link) }}
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.arImage) }}
                        {{ form_widget(form.arImage) }}
                        {{ form_errors(form.arImage) }}
                    </div>

                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-teal px-5 py-2 fw-semibold">
                            <i class="bi bi-send me-2"></i>Publish Article
                        </button>
                    </div>
                </div>
            </form>
        </section>

        {# ── Search / Filter ────────────────────────────────────────── #}
        <section class="row mb-4 g-2 align-items-end">
            <div class="col-md-5">
                <div class="search-wrap">
                    <i class="bi bi-search"></i>
                    <input id="searchInput" type="text" class="form-control"
                           placeholder="Search by title or author…"
                           value="{{ search }}">
                </div>
            </div>
            <div class="col-md-2">
                <button id="searchBtn" class="btn btn-teal w-100 fw-semibold">
                    <i class="bi bi-search me-1"></i>Search
                </button>
            </div>
            <div class="col-md-3">
                <select id="categoryFilter" class="form-select">
                    <option value="">Filter by category…</option>
                    <option value="Technology"    {% if category == 'Technology'    %}selected{% endif %}>Technology</option>
                    <option value="Data & AI"     {% if category == 'Data & AI'     %}selected{% endif %}>Data &amp; AI</option>
                    <option value="Cybersecurity" {% if category == 'Cybersecurity' %}selected{% endif %}>Cybersecurity</option>
                    <option value="HR & Careers"  {% if category == 'HR & Careers'  %}selected{% endif %}>HR &amp; Careers</option>
                    <option value="Company News"  {% if category == 'Company News'  %}selected{% endif %}>Company News</option>
                </select>
            </div>
            <div class="col-md-2">
                <button id="filterBtn" class="btn btn-teal w-100 fw-semibold">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </section>

        {# ── Articles table ──────────────────────────────────────────── #}
        <section class="card stats-card p-4 mb-5">
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <h3 class="section-title mb-0">Article List</h3>
                <span class="badge"
                      style="background:rgba(56,128,135,.12);color:var(--teal);font-size:.8rem;padding:.45em .9em;border-radius:20px;">
                {{ articles|length }} article{{ articles|length != 1 ? 's' : '' }}
            </span>
            </div>

            <div class="table-wrap">
                <table class="table table-hover mb-0">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Link</th>
                        <th>Image</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody id="articleTableBody">
                    {% if articles is empty %}
                        <tr>
                            <td colspan="8">
                                <div class="empty-state text-center">
                                    <i class="bi bi-newspaper"></i>
                                    No articles found
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        {% for art in articles %}
                            {% set catKey = art.category|replace({' ': '', '&': '', '-': ''}) %}
                            <tr data-id="{{ art.id }}">
                                <td class="text-muted">#{{ art.id }}</td>
                                <td class="fw-semibold text-start" style="max-width:200px;">{{ art.title }}</td>
                                <td>{{ art.authorName }}</td>
                                <td>
                                <span class="cat-badge cat-{{ catKey }} cat-default">
                                    {{ art.category }}
                                </span>
                                </td>
                                <td class="text-muted">
                                    {{ art.arDate ? art.arDate|date('d M Y') : '—' }}
                                </td>
                                <td>
                                    {% if art.link %}
                                        <a href="{{ art.link }}" target="_blank" class="link-cell d-block" title="{{ art.link }}">
                                            <i class="bi bi-link-45deg me-1"></i>Open
                                        </a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if art.arImage %}
                                        <img src="{{ art.arImage }}" alt="cover" class="img-thumb"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                                        <div class="no-img" style="display:none;"><i class="bi bi-image"></i></div>
                                    {% else %}
                                        <div class="no-img"><i class="bi bi-image"></i></div>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('article_view', {id: art.id}) }}"
                                       class="btn btn-sm btn-outline-primary btn-action me-1">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('article_edit', {id: art.id}) }}"
                                       class="btn btn-sm btn-outline-warning btn-action me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger btn-action btn-delete"
                                            data-id="{{ art.id }}"
                                            data-token="{{ csrf_token('delete_article_' ~ art.id) }}">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <div id="toast-container"></div>
{% endblock %}

{% block javascripts %}
    <script>
        /* ── Toast helper ─────────────────────────────────────────── */
        function toast(msg, type = 'success') {
            const c  = document.getElementById('toast-container');
            const el = document.createElement('div');
            el.className = `toast-msg toast-${type}`;
            el.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>${msg}`;
            c.appendChild(el);
            setTimeout(() => el.remove(), 3500);
        }

        /* ── Add Article (AJAX) ───────────────────────────────────── */
        document.getElementById('articleForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            // Build FormData from Symfony-named fields
            const fd = new FormData();
            const g  = name => this.querySelector(`[name$="[${name}]"]`)?.value ?? '';
            fd.append('article[title]',       g('title'));
            fd.append('article[category]',    g('category'));
            fd.append('article[description]', g('description'));
            fd.append('article[authorName]',  g('authorName'));
            fd.append('article[arDate]',      g('arDate'));
            fd.append('article[link]',        g('link'));
            fd.append('article[arImage]',     g('arImage'));

            try {
                const res  = await fetch('{{ path("article_index") }}', {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const json = await res.json();

                if (json.status === 'success') {
                    toast(json.message);
                    setTimeout(() => location.reload(), 800);
                } else {
                    toast(json.message || 'An error occurred.', 'error');
                }
            } catch {
                toast('Network error while publishing article.', 'error');
            }
        });

        /* ── Delete (AJAX) ────────────────────────────────────────── */
        document.getElementById('articleTableBody').addEventListener('click', async function(e) {
            const btn = e.target.closest('.btn-delete');
            if (!btn) return;

            if (!confirm('Are you sure you want to delete this article?')) return;

            const id    = btn.dataset.id;
            const token = btn.dataset.token;
            const row   = btn.closest('tr');

            const fd = new FormData();
            fd.append('_token', token);

            try {
                const res  = await fetch(`/articles/${id}/delete`, { method: 'POST', body: fd });
                const json = await res.json();

                if (json.status === 'success') {
                    row.style.opacity = '0';
                    row.style.transition = 'opacity .3s';
                    setTimeout(() => row.remove(), 300);
                    toast('Article deleted successfully.');
                } else {
                    toast(json.message || 'Delete failed.', 'error');
                }
            } catch {
                toast('Network error while deleting.', 'error');
            }
        });

        /* ── Live search (client-side) ────────────────────────────── */
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const q    = this.value.toLowerCase();
            const rows = document.querySelectorAll('#articleTableBody tr[data-id]');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });

        /* ── Search button (server-side) ──────────────────────────── */
        document.getElementById('searchBtn').addEventListener('click', function() {
            const q = document.getElementById('searchInput').value;
            window.location.href = `{{ path('article_index') }}?search=${encodeURIComponent(q)}`;
        });

        /* ── Category filter (server-side) ───────────────────────── */
        document.getElementById('filterBtn').addEventListener('click', function() {
            const cat = document.getElementById('categoryFilter').value;
            window.location.href = `{{ path('article_index') }}?category=${encodeURIComponent(cat)}`;
        });
    </script>
{% endblock %}
