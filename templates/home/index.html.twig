{% block javascripts %}
    <script>
        window.addEventListener("load", () => {
            document.querySelectorAll(".service-card-wrap").forEach((card, i) => {
                setTimeout(() => card.classList.add("show"), 300 + i * 150);
            });
        });

        const toggle = document.getElementById('themeToggle');

        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
            toggle.textContent = '☀️ Light Mode';
        }

        toggle.addEventListener('click', () => {
            document.body.classList.toggle('dark-mode');

            if (document.body.classList.contains('dark-mode')) {
                toggle.textContent = '☀️ Light Mode';
                localStorage.setItem('theme', 'dark');
            } else {
                toggle.textContent = '🌙 Dark Mode';
                localStorage.setItem('theme', 'light');
            }
        });


        document.getElementById('aboutModal').addEventListener('shown.bs.modal', function () {
            document.querySelectorAll('.counter').forEach(counter => {
                let count = 0;
                const target = parseInt(counter.getAttribute('data-target'));
                const step = target / 80;
                const timer = setInterval(() => {
                    count += step;
                    if (count >= target) {
                        counter.textContent = target + '+';
                        clearInterval(timer);
                    } else {
                        counter.textContent = Math.round(count);
                    }
                }, 16);
            });
        });
    </script>
{% endblock %}
