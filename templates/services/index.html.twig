
{% extends 'layout/base.html.twig' %}

{% block title %}Employee Dashboard – Services{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ── Base ───────────────────────────────────────────────── */
body {
  background-color: #F6F6F2;
  font-family: 'Inter', sans-serif;
  color: #1f2933;
}

/* ── Navbar ─────────────────────────────────────────────── */
.navbar { background-color: #388087; }
.dropdown-toggle::after { display: none; }

/* ── Cards ──────────────────────────────────────────────── */
.card {
  border: none;
  border-radius: 16px;
  box-shadow: 0 10px 28px rgba(0,0,0,0.06);
  transition: transform .3s ease;
}
.card:hover { transform: translateY(-3px); }

.card-header {
  background-color: #102E4A;
  color: white;
  font-weight: 600;
  border-radius: 16px 16px 0 0 !important;
}

/* ── Forms ──────────────────────────────────────────────── */
.form-control, .form-select { transition: all 0.3s ease; }
.form-control:focus, .form-select:focus {
  transform: translateX(4px);
  border-color: #102E4A;
  box-shadow: 0 4px 8px rgba(16,46,74,0.12);
}

/* ── Buttons ─────────────────────────────────────────────── */
.btn-primary-custom { background-color: #388087; color: white; border: none; }
.btn-primary-custom:hover { background-color: #2f6f75; color: white; }

/* ── Toggle mode ─────────────────────────────────────────── */
.toggle-group {
  background: #f1f3f5;
  padding: 4px;
  border-radius: 12px;
  display: inline-flex;
}
.btn-custom-toggle {
  border: none;
  padding: 6px 18px;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 600;
  transition: all 0.2s ease;
  background: transparent;
  color: #64748b;
}
.btn-custom-toggle.active {
  background: #ffffff;
  color: #102e4a;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

/* ── Table ───────────────────────────────────────────────── */
.table thead th {
  border-top: none;
  color: #64748b;
  letter-spacing: 0.5px;
  padding-top: 14px;
  padding-bottom: 14px;
  font-size: 0.78rem;
  text-transform: uppercase;
}
#services-tbody tr td { padding-top: 11px; padding-bottom: 11px; }

/* ── Client search ───────────────────────────────────────── */
#search-results {
  border: 1px solid #dee2e6;
  border-radius: 0.5rem;
  background: white;
  z-index: 1000;
  max-height: 200px;
  overflow-y: auto;
}
#search-results .list-group-item {
  cursor: pointer;
  transition: background 0.2s;
  border: none;
  padding: 10px 15px;
}
#search-results .list-group-item:hover { background-color: #f8f9fa; color: #388087; }
.custom-search-container .form-control:focus { box-shadow: none; border-color: #dee2e6; }

/* ── KPI soft alert ──────────────────────────────────────── */
.soft-alert {
  background-color: rgba(56,128,135,0.10);
  border-left: 4px solid #388087;
  border-radius: 12px;
}

/* ── Icon shapes ─────────────────────────────────────────── */
.icon-shape {
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 10px;
}
.bg-soft-primary { background-color: rgba(56, 128, 135, 0.1); }

/* ── Table inputs ─────────────────────────────────────────── */
.table .form-control-sm { border-color: #e2e8f0; border-radius: 6px; }
.table .form-control-sm:focus { box-shadow: 0 0 0 3px rgba(56, 128, 135, 0.1); }

/* ── Footer ──────────────────────────────────────────────── */
.footer-forest { background: linear-gradient(180deg, #388087 0%, #0d1f1b 100%); }
.footer-link { color: rgba(255,255,255,0.8); text-decoration: none; }
.footer-link:hover { color: white; padding-left: 5px; }

/* ── Toasts ──────────────────────────────────────────────── */
@keyframes slideIn  { from { transform: translateX(120%); opacity:0; } to { transform: translateX(0); opacity:1; } }
@keyframes slideOut { from { transform: translateX(0); opacity:1; } to { transform: translateX(120%); opacity:0; } }

/* ── Receipt modal ───────────────────────────────────────── */
@media print {
  body * { visibility: hidden; }
  #receipt-content, #receipt-content * { visibility: visible; }
  #receipt-content { position: absolute; left: 0; top: 0; width: 100%; }
  .modal-footer, .btn-close { display: none !important; }
}
</style>
{% endblock %}

{% block body %}

{# ── Navbar ── #}
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="#">Employee Dashboard</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-center" id="nav">
      <ul class="navbar-nav gap-4 fw-semibold">
        <li class="nav-item"><a class="nav-link" href="{{ path('client_index') }}">Clients</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ path('sales_index')}}">Sales</a></li>
        <li class="nav-item"><a class="nav-link active" href="{{ path('services_index')}}">Services</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ path('stock_index')}}">Stock</a></li>
      </ul>
    </div>

    <div class="d-flex align-items-center ms-auto">
      <div class="dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
          <img src="{{ asset('images/profile.png') }}" class="rounded-circle me-2" width="32" height="32">
          <span class="text-white">{{ app.user ? app.user.userIdentifier : 'Employee' }}</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" style="background-color: #212529;">
          <li>
            <a class="dropdown-item text-white" href="#">
              <i class="bi bi-person me-2"></i> Profile
            </a>
          </li>
          <li><hr class="dropdown-divider border-secondary"></li>
          <li>
            <a class="dropdown-item text-danger" href="#">
              <i class="bi bi-box-arrow-right me-2"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

{# ── Page header ── #}
<div class="container-fluid mt-4">

  <div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <h4 class="mb-1 fw-bold">New Sales Transaction</h4>
        <small class="text-muted">Create a product sale or service transaction for a client.</small>
      </div>
      <span class="badge bg-secondary fs-6">
        <i class="bi bi-person me-1"></i>
        {{ app.user ? app.user.userIdentifier : 'Employee' }}
      </span>
    </div>
  </div>

  {# ── KPI row ── #}
  <div class="row mb-4 text-center g-3">
    <div class="col-md-3">
      <div class="card p-3">
        <i class="bi bi-clock-history fs-4 text-primary mb-1"></i>
        <p class="mb-0 fw-semibold small text-muted">Today's Sales Count</p>
        <h3 id="stat-today-count" class="mb-0 fw-bold">—</h3>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3">
        <i class="bi bi-wallet2 fs-4 text-success mb-1"></i>
        <p class="mb-0 fw-semibold small text-muted">Today's Revenue</p>
        <h3 id="stat-today-amount" class="mb-0 fw-bold">—</h3>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3">
        <i class="bi bi-bar-chart-line fs-4 text-info mb-1"></i>
        <p class="mb-0 fw-semibold small text-muted">Monthly Revenue</p>
        <h3 id="stat-month-amount" class="mb-0 fw-bold">—</h3>
        <span id="stat-month-count" class="d-none">0</span>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3">
        <i class="bi bi-star-fill fs-4 text-warning mb-1"></i>
        <p class="mb-0 fw-semibold small text-muted">Total Clients</p>
        <h3 id="stat-clients" class="mb-0 fw-bold">—</h3>
      </div>
    </div>
  </div>

  {# ── Main two-column layout ── #}
  <div class="row g-4">

    {# LEFT: Client info + Chart ── #}
    <div class="col-lg-7">

      {# Client Info card #}
      <div class="card mb-4">
        <div class="card-header">
          <i class="bi bi-person me-2"></i> Client Information
        </div>
        <div class="card-body row g-3">

          {# Client search #}
          <div class="col-md-8">
            <label class="form-label fw-semibold small text-muted text-uppercase">Select Client</label>
            <div class="custom-search-container position-relative">
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                  <i class="bi bi-person-search"></i>
                </span>
                <input type="text"
                       id="client-search-input"
                       class="form-control border-start-0 ps-0"
                       placeholder="Type to filter clients…"
                       autocomplete="off">
              </div>
              <div id="search-results"
                   class="list-group shadow-sm position-absolute w-100 mt-1 d-none">
              </div>
              <input type="hidden" id="client-id">
            </div>
          </div>

          {# Email #}
          <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted text-uppercase">Email</label>
            <input class="form-control" id="client-email" placeholder="Auto-filled" readonly>
          </div>

          {# Last purchase / Total spent #}
          <div class="col-12">
            <div class="soft-alert p-3 text-center">
              <div class="row">
                <div class="col-md-6">
                  <i class="bi bi-clock-history fs-4"></i>
                  <p class="mb-0 fw-semibold">Last Purchase</p>
                  <small id="last-purchase-date" class="text-muted">—</small>
                </div>
                <div class="col-md-6">
                  <i class="bi bi-wallet2 fs-4"></i>
                  <p class="mb-0 fw-semibold">Total Spent</p>
                  <small id="client-total-spent" class="text-muted">$0</small>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      {# Sales chart #}
      <div class="card mb-4">
        <div class="card-header">
          <i class="bi bi-graph-up me-2"></i> Sales Overview (Last 7 Days)
        </div>
        <div class="card-body">
          <canvas id="salesChart" height="120"></canvas>
        </div>
      </div>

    </div>{# /col-lg-7 #}

    {# RIGHT: Items table + Order summary ── #}
    <div class="col-lg-5">

      {# Items card #}
      <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <div class="icon-shape bg-soft-primary me-3">
              <i class="bi bi-cart-plus fs-5 text-primary"></i>
            </div>
            <h5 class="mb-0 fw-bold text-dark">Rendered Items</h5>
          </div>
          <div class="toggle-group">
            <button class="btn btn-custom-toggle active" id="mode-sales" onclick="setMode('sales')">
              <i class="bi bi-box me-1"></i>Sales
            </button>
            <button class="btn btn-custom-toggle" id="mode-services" onclick="setMode('services')">
              <i class="bi bi-tools me-1"></i>Services
            </button>
          </div>
        </div>

        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th class="ps-4" id="type-header" style="width:40%">Product Name</th>
                  <th style="width:15%">Qty/Hrs</th>
                  <th style="width:20%">Price</th>
                  <th style="width:15%">Total</th>
                  <th class="text-end pe-4" style="width:10%"></th>
                </tr>
              </thead>
              <tbody id="services-tbody"></tbody>
            </table>
          </div>
        </div>

        <div class="card-footer bg-white border-top-0 py-3 ps-4">
          <button class="btn btn-light btn-sm text-primary fw-semibold d-flex align-items-center"
                  onclick="addRow()">
            <i class="bi bi-plus-circle-fill me-2"></i> Add New Line
          </button>
        </div>
      </div>

      {# Order summary card #}
      <div class="card">
        <div class="card-header">
          <i class="bi bi-receipt me-2"></i> Order Summary
        </div>
        <div class="card-body">

          {# Payment method #}
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted text-uppercase">Payment Method</label>
            <select id="payment-method" class="form-select">
              <option value="Cash">Cash</option>
              <option value="Card">Card</option>
              <option value="Bank Transfer">Bank Transfer</option>
              <option value="Cheque">Cheque</option>
            </select>
          </div>

          {# Discount input #}
          <div class="mb-3">
            <label class="form-label fw-semibold small text-muted text-uppercase">Discount ($)</label>
            <input type="number" id="discount-input" class="form-control"
                   min="0" step="0.01" value="0" placeholder="0.00"
                   oninput="updateTotals()">
          </div>

          <hr>

          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Subtotal</span>
            <span id="summary-subtotal" class="fw-semibold">$0.00</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Discount</span>
            <span id="summary-discount" class="fw-semibold text-danger">-$0.00</span>
          </div>
          <div class="d-flex justify-content-between mb-3">
            <span class="text-muted">Tax (10%)</span>
            <span id="summary-tax" class="fw-semibold">$0.00</span>
          </div>

          <hr>

          <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
            <span>Total</span>
            <span id="summary-total" class="text-success">$0.00</span>
          </div>

          <button class="btn btn-primary-custom w-100 py-2 fw-semibold"
                  id="btn-process-transaction">
            <i class="bi bi-check-circle me-2"></i> Process Transaction
          </button>

        </div>
      </div>

    </div>{# /col-lg-5 #}
  </div>{# /row #}
</div>{# /container-fluid #}

{# ── Receipt Modal ── #}
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content" style="border-radius:16px;overflow:hidden;">

      <div class="modal-header" style="background:#102E4A;color:white;">
        <h5 class="modal-title fw-bold">
          <i class="bi bi-receipt me-2"></i>Transaction Receipt
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"
                style="filter:invert(1);"></button>
      </div>

      <div class="modal-body" id="receipt-content">
        <div class="text-center mb-4">
          <h4 class="fw-bold mb-0">Entreprisa</h4>
          <p class="text-muted small">Official Transaction Receipt</p>
        </div>

        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Transaction ID:</span>
          <span id="receipt-id" class="fw-semibold">—</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted">Date:</span>
          <span id="receipt-date">—</span>
        </div>
        <div class="d-flex justify-content-between mb-4">
          <span class="text-muted">Client:</span>
          <span id="receipt-client-name" class="fw-semibold">—</span>
        </div>

        <table class="table table-sm">
          <thead class="table-light">
            <tr>
              <th>Item</th>
              <th class="text-center">Qty</th>
              <th class="text-end">Total</th>
            </tr>
          </thead>
          <tbody id="receipt-items"></tbody>
        </table>

        <div class="border-top pt-3">
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Subtotal</span>
            <span id="receipt-subtotal">—</span>
          </div>
          <div class="d-flex justify-content-between mb-1 text-danger">
            <span>Discount</span>
            <span id="receipt-discount">—</span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Tax (10%)</span>
            <span id="receipt-tax">—</span>
          </div>
          <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
            <span>Total Paid</span>
            <span id="receipt-total" class="text-success">—</span>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary"
                data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary-custom"
                onclick="window.print()">
          <i class="bi bi-printer me-2"></i>Print Receipt
        </button>
      </div>

    </div>
  </div>
</div>

{# ── Footer ── #}
<footer class="footer-forest text-white py-5 mt-4" style="min-height:360px;">
  <div class="container" style="margin-top:4rem;">
    <div class="row gy-4">
      <div class="col-lg-4 col-md-12">
        <span class="fw-bold fs-4 text-uppercase">Entreprisa</span>
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <h6 class="text-uppercase small fw-bold mb-3 opacity-50">Start your business</h6>
        <ul class="list-unstyled">
          <li class="mb-2"><a href="#" class="footer-link">Join us as a company leader</a></li>
          <li class="mb-2"><a href="#" class="footer-link">Try Entreprisa</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <h6 class="text-uppercase small fw-bold mb-3 opacity-50">The Product</h6>
        <ul class="list-unstyled">
          <li class="mb-2"><a href="#" class="footer-link">Contact us</a></li>
          <li class="mb-2"><a href="#" class="footer-link">Questions</a></li>
          <li class="mb-2"><a href="#" class="footer-link">Blog</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <h6 class="text-uppercase small fw-bold mb-3 opacity-50">Legal</h6>
        <ul class="list-unstyled">
          <li class="mb-2"><a href="#" class="footer-link">Terms &amp; Conditions</a></li>
          <li class="mb-2"><a href="#" class="footer-link">Privacy policy</a></li>
        </ul>
      </div>
    </div>
    <hr class="opacity-25">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small opacity-50 pt-3">
      <p class="mb-0">© 2026 Entreprisa. All rights reserved.</p>
    </div>
  </div>
</footer>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

{# Pass Symfony routes to JS #}
<script>
const ROUTES = {
    salesStats:    "{{ path('sales_api_stats') }}",
    salesCreate:   "{{ path('sales_api_create') }}",
    clientsList:   "{{ path('client_api_list') }}",
    clientsGet:    "{{ path('client_index', {'id': '__ID__'}) }}",
    productsList:  "{{ path('product_api_list') }}",
    servicesList:  "{{ path('services_list') }}",
};
</script>

<script src="{{ asset('js/employee dashboard.js') }}"></script>
{% endblock %}
